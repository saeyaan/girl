{
  "manifest_version": 3,
  "name": "SAGE - AI Browser Assistant",
  "version": "3.0.0",
  "minimum_chrome_version": "116",
  "description": "Lets the SAGE voice assistant see your current tab, search, open results and control videos, with every action verified.",
  "key": "",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAGE Browser Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "announce.js"
      ],
      "run_at": "document_start"
    }
  ]
}
